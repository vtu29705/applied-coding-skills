class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {
        int n = nums.length;
        int totalSum = 0;
        
        // Calculate the total sum of all elements
        for (int num : nums) {
            totalSum += num;
        }
        
        int[] result = new int[n];
        int leftSum = 0;
        
        for (int i = 0; i < n; i++) {
            int rightSum = totalSum - leftSum - nums[i];
            
            // Left elements count = i, Right elements count = n - 1 - i
            result[i] = (nums[i] * i - leftSum) + (rightSum - nums[i] * (n - 1 - i));
            
            // Update leftSum for the next iteration
            leftSum += nums[i];
        }
        
        return result;
    }
}
